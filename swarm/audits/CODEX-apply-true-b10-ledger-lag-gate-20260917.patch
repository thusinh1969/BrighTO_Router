+def sql_quote(value):
+    return "'" + value.replace("'", "''") + "'"
+
+
+def psql_row(port, sql):
+    out = sh(
+        "psql", "-h", "127.0.0.1", "-p", str(port), "-U", "llm_router", "-d", "llm_router",
+        "-At", "-F", "\t", "-c", sql,
+        env=dict(os.environ, PGPASSWORD="llm_router_dev"),
+    ).stdout.strip()
+    return out.split("\t") if out else []
+
