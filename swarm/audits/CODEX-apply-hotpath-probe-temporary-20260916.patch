diff --git a/src/probe.rs b/src/probe.rs
new file mode 100644
--- /dev/null
+++ b/src/probe.rs
@@ -0,0 +1,93 @@
+//! Temporary aggregate hot-path probe. Disabled unless BRIGTO_HOTPATH_PROBE=1.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use dashmap::DashMap;
+
+#[derive(Default)]
+struct Agg {
+    count: AtomicU64,
+    total_ns: AtomicU64,
+    max_ns: AtomicU64,
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        std::env::var("BRIGTO_HOTPATH_PROBE")
+            .map(|v| {
+                let v = v.trim().to_ascii_lowercase();
+                !matches!(v.as_str(), "" | "0" | "false" | "off" | "no")
+            })
+            .unwrap_or(false)
+    })
+}
+
+fn spans() -> &'static DashMap<&'static str, Agg> {
+    static SPANS: OnceLock<DashMap<&'static str, Agg>> = OnceLock::new();
+    SPANS.get_or_init(DashMap::new)
+}
+
+pub fn record(span: &'static str, elapsed: Duration) {
+    if !enabled() {
+        return;
+    }
+    let ns = u64::try_from(elapsed.as_nanos()).unwrap_or(u64::MAX);
+    let entry = spans().entry(span).or_default();
+    entry.count.fetch_add(1, Ordering::Relaxed);
+    entry.total_ns.fetch_add(ns, Ordering::Relaxed);
+    entry.max_ns.fetch_max(ns, Ordering::Relaxed);
+}
+
+pub fn emit_if_due() {
+    if !enabled() {
+        return;
+    }
+
+    static LAST_EMIT_MS: AtomicU64 = AtomicU64::new(0);
+    let now = now_ms();
+    let last = LAST_EMIT_MS.load(Ordering::Relaxed);
+    if now.saturating_sub(last) < 1_000 {
+        return;
+    }
+    if LAST_EMIT_MS
+        .compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed)
+        .is_err()
+    {
+        return;
+    }
+
+    let mut rows = Vec::new();
+    for entry in spans().iter() {
+        let count = entry.count.load(Ordering::Relaxed);
+        if count == 0 {
+            continue;
+        }
+        let total_ns = entry.total_ns.load(Ordering::Relaxed);
+        let max_ns = entry.max_ns.load(Ordering::Relaxed);
+        rows.push(serde_json::json!({
+            "span": *entry.key(),
+            "count": count,
+            "total_us": total_ns / 1_000,
+            "avg_us": (total_ns / count) / 1_000,
+            "max_us": max_ns / 1_000,
+        }));
+    }
+    rows.sort_by(|a, b| {
+        b.get("total_us")
+            .and_then(serde_json::Value::as_u64)
+            .cmp(&a.get("total_us").and_then(serde_json::Value::as_u64))
+    });
+
+    let payload = serde_json::json!({"ts_ms": now, "spans": rows});
+    eprintln!("BRIGTO_HOTPATH_PROBE {}", payload);
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
