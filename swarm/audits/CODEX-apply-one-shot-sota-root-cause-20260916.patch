+def prometheus_counter_total(text, name):
+    total = 0.0
+    for line in text.splitlines():
+        if line.startswith("#") or not line.startswith(name):
+            continue
+        parts = line.split()
+        if len(parts) >= 2:
+            try:
+                total += float(parts[-1])
+            except ValueError:
+                pass
+    return total
