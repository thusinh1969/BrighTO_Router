--- /dev/null
+++ b/scripts/test_postgres.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# One-command test wrapper for sqlx::test integration tests.
+# It starts an isolated Postgres/pgvector container when DATABASE_URL is not already provided.
+set -euo pipefail
+
+if [[ -n "${DATABASE_URL:-}" ]]; then
+  exec cargo test --locked --all-targets "$@"
+fi
+
+if ! command -v docker >/dev/null 2>&1; then
+  echo "DATABASE_URL is not set and docker is not available; cannot run Postgres-backed tests" >&2
+  exit 1
+fi
+
+pg="brigto_test_pg_$$"
+cleanup() {
+  docker stop "$pg" >/dev/null 2>&1 || true
+}
+trap cleanup EXIT INT TERM
+
+docker run --rm -d --name "$pg" \
+  -e POSTGRES_DB=llm_router \
+  -e POSTGRES_USER=llm_router \
+  -e POSTGRES_PASSWORD=llm_router_dev \
+  -p 127.0.0.1::5432 \
+  pgvector/pgvector:pg16 >/dev/null
+
+for _ in $(seq 1 60); do
+  if docker exec "$pg" pg_isready -U llm_router -d llm_router >/dev/null 2>&1; then
+    break
+  fi
+  sleep 1
+done
+
+port="$(docker port "$pg" 5432/tcp | sed 's/.*://')"
+if [[ -z "$port" ]]; then
+  echo "failed to resolve temporary Postgres port" >&2
+  exit 1
+fi
+
+export DATABASE_URL="postgres://llm_router:llm_router_dev@127.0.0.1:${port}/llm_router"
+exec cargo test --locked --all-targets "$@"
