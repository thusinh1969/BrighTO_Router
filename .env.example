# BrighTO-Router default local runtime config.
# Copy to .env, or run ./start.sh start and it will create .env automatically.
# This file is safe for local development. Change ADMIN_MASTER_KEY before production.

DATABASE_URL=postgres://brighto_router:brighto_router_dev@127.0.0.1:5432/brighto_router
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=brighto_router
DB_USER=brighto_router
DB_PASS=brighto_router_dev
LISTEN_ADDR=0.0.0.0:8080
ADMIN_MASTER_KEY=brighto-admin-dev
ADMIN_ALLOW_CIDR=10.0.0.0/8,127.0.0.1/32
MAX_BODY_BYTES=67108864
CONFIG_POLL_SECS=5
LEDGER_FALLBACK_FILE=/var/lib/brighto-router/ledger-fallback.jsonl
RUST_LOG=brighto_router=info,tower_http=warn

# Backend provider keys are injected through env vars referenced by backends.api_key_ref.
# Leave blank for mock/test setups; set real values for production routes.
BACKEND_KEY_GX10=
BACKEND_KEY_B300_1=
BACKEND_KEY_B300_2=
BACKEND_KEY_A6000=
BACKEND_KEY_ANTHROPIC=
