# BrighTO-Router default local runtime config.
# Copy to .env, or run ./start.sh start and it will create .env automatically.
# This file is safe for local development. Change ADMIN_MASTER_KEY before production.

DATABASE_URL=postgres://brighto_router:brighto_router_dev@127.0.0.1:55432/brighto_router
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=brighto_router
DB_USER=brighto_router
DB_PASS=brighto_router_dev
LISTEN_ADDR=0.0.0.0:18080
ADMIN_MASTER_KEY=brightoIsGreat@2026
ADMIN_ALLOW_CIDR=0.0.0.0/0,::/0
MAX_BODY_BYTES=67108864
CONFIG_POLL_SECS=5
LEDGER_FALLBACK_FILE=/var/lib/brighto-router/ledger-fallback.jsonl
RUST_LOG=brighto_router=info,tower_http=warn

# Optional UI design mode. Leave blank in production.
# If set to /app/static/index.html under Docker Compose, Portal HTML/CSS/JS is read from disk on each refresh.
# This lets you edit static/index.html and press F5 without rebuilding the Rust binary.
PORTAL_STATIC_FILE=

# Optional direct HTTPS with custom PEM files.
# Requires a router image/binary that supports TLS_CERT_PATH and TLS_KEY_PATH.
# Mount ./ssl:/certs:ro in docker-compose.yml, then uncomment:
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem

# Backend provider keys are injected through env vars referenced by backends.api_key_ref.
# Leave blank for mock/test setups; set real values for production routes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
META_MUSE_API_KEY=
CUSTOM_LLM_API_KEY=

# Optional old/local backend keys used by custom deployments.
BACKEND_KEY_GX10=
BACKEND_KEY_B300_1=
BACKEND_KEY_B300_2=
BACKEND_KEY_A6000=
BACKEND_KEY_ANTHROPIC=
