# BrighTO-Router default local runtime config.
# Copy to .env, or run ./start.sh start and it will create .env automatically.
# This file is safe for local development. Change ADMIN_MASTER_KEY before production.

DATABASE_URL=postgres://brighto_router:brighto_router_dev@127.0.0.1:55432/brighto_router
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=brighto_router
DB_USER=brighto_router
DB_PASS=brighto_router_dev
LISTEN_ADDR=0.0.0.0:18080
ADMIN_MASTER_KEY=brightoIsGreat@2026
ADMIN_ALLOW_CIDR=0.0.0.0/0,::/0
MAX_BODY_BYTES=67108864
CONFIG_POLL_SECS=5
BACKEND_CIRCUIT_OPEN_SECONDS=30
LEDGER_FALLBACK_FILE=/var/lib/brighto-router/ledger-fallback.jsonl
DATA_DIR=/var/lib/brighto-router
RUST_LOG=brighto_router=info,tower_http=warn
BRIGHTO_ROUTER_IMAGE=thusinh1969/brighto_airouter:preview-3

# Optional client smoke-test defaults used by ./test_router.py.
# This is a BrighTO client key, not a provider key. The demo key is seeded for local testing.
BRIGHTO_ROUTER_API_KEY=sk-brighto-0123456789abcdef0123456789abcdef
BRIGHTO_MODEL=

# Optional UI design mode. Leave blank in production.
# If set to /app/static/index.html under Docker Compose, Portal HTML/CSS/JS is read from disk on each refresh.
# This lets you edit static/index.html and press F5 without rebuilding the Rust binary.
PORTAL_STATIC_FILE=

# Provider picker presets: key|label|base_url|protocol_family|env_key|enabled, separated by semicolons.
PROVIDER_CATALOG="openai|OpenAI|https://api.openai.com|openai|OPENAI_API_KEY|1;anthropic|Anthropic|https://api.anthropic.com|anthropic|ANTHROPIC_API_KEY|1;gemini|Gemini|https://generativelanguage.googleapis.com/v1beta/openai|openai|GEMINI_API_KEY|0;deepseek|DeepSeek|https://api.deepseek.com|openai|DEEPSEEK_API_KEY|1;kimi|Kimi|https://api.moonshot.ai/v1|openai|KIMI_API_KEY|1;qwen|Qwen|https://dashscope-intl.aliyuncs.com/compatible-mode/v1|openai|QWEN_API_KEY|1;zai|Z.AI|https://api.z.ai/api/paas/v4|openai|ZAI_API_KEY|1;openrouter|OpenRouter|https://openrouter.ai/api/v1|openai|OPENROUTER_API_KEY|1;jina|Jina AI|https://api.jina.ai|openai|JINA_API_KEY|1;voyage|Voyage AI|https://api.voyageai.com|openai|VOYAGE_API_KEY|1;cohere|Cohere|https://api.cohere.com/v2|openai|COHERE_API_KEY|1;meta-muse|Meta Muse|https://api.meta.ai/v1|openai|META_MUSE_API_KEY|0;custom-llm|Custom LLM|http://127.0.0.1:8088/v1|openai|CUSTOM_LLM_API_KEY|1"

# Optional direct HTTPS with custom PEM files.
# Requires a router image/binary that supports TLS_CERT_PATH and TLS_KEY_PATH.
# Mount ./ssl:/certs:ro in docker-compose.yml, then uncomment:
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem

# Backend provider keys are injected through env vars referenced by backends.api_key_ref.
# Leave blank for mock/test setups; set real values for production routes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
META_MUSE_API_KEY=
CUSTOM_LLM_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
DASHSCOPE_API_KEY=

# Optional preview-3 live Model Group smoke defaults.
# Used by smoke/model_group/live_openai_chat.py; leave blank unless you run that live smoke.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8088/v1
LOCAL_OPENAI_MODEL=qwen3.8-flash-next
BRIGHTO_MODEL_GROUP=coding-fast-live
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional for Qwen rerank live smoke / Portal. International default can use https://dashscope-intl.aliyuncs.com;
# workspace deployments can use https://<workspace>.<region>.maas.aliyuncs.com.
QWEN_RERANK_BASE_URL=

# Optional old/local backend keys used by custom deployments.
BACKEND_KEY_GX10=
BACKEND_KEY_B300_1=
BACKEND_KEY_B300_2=
BACKEND_KEY_A6000=
BACKEND_KEY_ANTHROPIC=
