# Copy to uat/.env.uat (gitignored). uat/start.sh can create it and generate
# the admin/client keys automatically if it is missing.
#
# This file is for the isolated UAT stack only. Never point it at the
# production database, ports, image, or .env.

# --- Router control plane -------------------------------------------------
ADMIN_MASTER_KEY=replace-with-a-long-random-admin-key
ADMIN_ALLOW_CIDR=0.0.0.0/0,::/0
MAX_BODY_BYTES=67108864
CONFIG_POLL_SECS=2
READY_MAX_STALE_MS=10000
RUST_LOG=brighto_router=info,tower_http=warn
ROUTER_WORKER_THREADS=2

# --- UAT PostgreSQL -------------------------------------------------------
DB_PASS=brighto_router_uat

# --- UAT image ------------------------------------------------------------
BRIGHTO_ROUTER_IMAGE=thusinh1969/brighto_airouter:uat-qwen-dual

# --- Client seed (written into the UAT database by uat/start.sh) ----------
UAT_CLIENT_KEY=sk-brighto-uat-replace-with-a-random-client-key

# --- Single local Qwen 3.8 model, dual OpenAI + Anthropic ------------------
# The UAT router reaches the host through host.docker.internal. The local
# llama.cpp/vLLM server must listen on 0.0.0.0 (not only 127.0.0.1).
# This is the only public model seeded in UAT.
UAT_QWEN_BASE_URL=http://host.docker.internal:8088/v1
UAT_QWEN_MODEL=qwen3.8-flash-next

# --- UAT TLS --------------------------------------------------------------
# auto: use ../ssl/fullchain.pem + ../ssl/privkey.pem when present, else HTTP.
# 0: force plain HTTP. start.sh copies the certs to uat/tls and sets
# UAT_BASE_URL/UAT_CA_CERT automatically.
UAT_TLS=auto
UAT_BASE_URL=https://127.0.0.1:18081

# --- Client access --------------------------------------------------------
# Use the host name or IP reachable by the client, for example:
# UAT_BASE_URL=https://<router-host>:18081
