        "focus": [
          "route_engine",
          "adapters",
          "providers",
          "systemone"
        ],
        "note": "Chat, embeddings, rerank, ASR, Anthropic Messages, and System One decisions stay task-aware without bloating the hot path."
      },
      {
        "id": "usage-release",
        "label": "Usage + proof",
        "focus": [
          "router",
          "ledger_queue",
          "usage",
          "fallback",
          "release_gate"
        ],
        "note": "Usage metadata is queued and batched; release proof covers browser, API, Docker, and feature smoke."
      }
