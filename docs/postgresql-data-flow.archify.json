        "id": "control-plane",
        "label": "Control plane",
        "focus": [
          "portal",
          "admin_api",
          "control_tables",
          "snapshot"
        ],
        "note": "Admin changes persist in PostgreSQL, then reload into the runtime snapshot."
      },
      {
        "id": "hot-path",
        "label": "Hot path",
        "focus": [
          "client",
          "router_hot",
          "snapshot",
          "provider"
        ],
        "note": "Request routing uses memory state; PostgreSQL is not touched per token."
      },
      {
        "id": "ledger-path",
        "label": "Usage ledger",
        "focus": [
          "router_hot",
          "ledger_queue",
          "usage_table",
          "fallback_file",
          "dashboard"
        ],
        "note": "Usage metadata is queued, batched, and replayed if PostgreSQL recovers after an outage."
      }
    ]
  },
